# Copy this file to .env and adjust as needed. All values below are the
# defaults used by app/core/config.py if a variable is not set.

# --- General ---
APP_NAME="AI Multimodal Tutor"
ENV=development
DEBUG=true

# --- Database ---
# SQLite by default; point this at Postgres/MySQL for production if desired.
DATABASE_URL=sqlite:///./data/tutor.db

# --- Storage ---
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
MAX_UPLOAD_SIZE_MB=8
ALLOWED_UPLOAD_EXTENSIONS=.png,.jpg,.jpeg,.webp

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OCR provider selection ---
# ml (classical-ML recognizer, default) | demo (fixtures) | trocr | donut | vision_api
# trocr/donut are optional deep-learning baselines and need requirements-dl.txt
DEFAULT_OCR_PROVIDER=ml

# --- Vision-language API (optional - only needed for provider=vision_api) ---
# One of: none | anthropic | openai_compatible
VISION_API_BACKEND=none

# Anthropic Claude backend
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI-compatible backend (e.g. a self-hosted Qwen-VL endpoint)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# --- Local HuggingFace models ---
TROCR_MODEL_NAME=microsoft/trocr-base-handwritten
DONUT_MODEL_NAME=naver-clova-ix/donut-base
# One of: cpu | cuda | mps | auto
HF_DEVICE=auto
HF_CACHE_DIR=

# --- Logging ---
LOG_LEVEL=INFO
